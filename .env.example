NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: enable public, browser-local fictional banking demo routes.
# All /banking and /api/banking/* remain authentication-protected.
COMPETITION_PUBLIC_DEMO=1

# Required in production: public Cloudflare Turnstile site key.
# Configure its matching SECRET in Supabase Auth > Bot and Abuse Protection, never here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional signed-in banking language interpreter. Server-only; never NEXT_PUBLIC_.
# Leave deterministic for a no-key scripted simulation.
BANK_AGENT_MODE=deterministic
# Choose openai (default) or openrouter. Never use NEXT_PUBLIC_ for provider secrets.
BANK_AGENT_PROVIDER=openai
OPENAI_API_KEY=
# Set explicitly to a Responses API model supporting structured outputs.
OPENAI_AGENT_MODEL=
# Optional existing human support destination; HTTPS URL or plain mailto address.
# Leave blank until a real support channel is available. Nothing is sent automatically.
FU_BANK_SUPPORT_URL=
# Optional OpenRouter connection. Choose a model/provider supporting JSON Schema.
OPENROUTER_API_KEY=
OPENROUTER_AGENT_MODEL=
# Local fictional conversations only: allow free providers to collect demo chat data.
OPENROUTER_DEMO_ALLOW_DATA_COLLECTION=false
# Hosted fictional demo chat only; configure the shared SQL store and its separate secret hash.
FUFU_DEMO_SHARED_STORE=false
FUFU_DEMO_SERVER_SECRET=
